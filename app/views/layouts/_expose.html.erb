<script type="application/javascript">
  window.exposedProperties = {};

  Object.defineProperty(exposedProperties, 'ALLOWED_POST_ATTRS', {
    configurable: false,
    value: Object.freeze(<%= raw PostsHelper::PostScrubber::ALLOWED_ATTRS %>),
    writable: false,
  });

  Object.defineProperty(exposedProperties, 'ALLOWED_POST_TAGS', {
    configurable: false,
    value: Object.freeze(<%= raw PostsHelper::PostScrubber::ALLOWED_TAGS %>),
    writable: false,
  });

  Object.defineProperty(exposedProperties, 'LOCALE', {
    configurable: false,
    value: "<%= I18n.locale %>",
    writable: false,
  });

  Object.defineProperty(exposedProperties, 'MAX_UPLOAD_SIZE', {
    configurable: false,
    value: <%= SiteSetting['MaxRequestBodySize'].presence || 2 * 1024 * 1024 %>,
    writable: false,
  });
</script>
